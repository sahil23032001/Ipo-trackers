{
  "version": 2,
  "builds": [
    { "src": "api/ipos.js", "use": "@vercel/node" },
    { "src": "api/ipo.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ipos", "dest": "/api/ipos.js" },
    { "src": "/api/ipo", "dest": "/api/ipo.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
